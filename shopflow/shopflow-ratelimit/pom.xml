<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.shopflow</groupId>
        <artifactId>shopflow-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>shopflow-ratelimit</artifactId>
    <name>shopflow-ratelimit</name>
    <description>Five rate-limiting algorithms (fixed/sliding-window, token/leaky bucket) with two backends
        — in-memory (single node) and Redis+Lua (distributed, atomic) — selectable by config. Runnable demo.</description>

    <!-- web/actuator/micrometer/test are inherited from shopflow-parent. The only extra this module
         needs is the Redis client for the distributed (Lua) backend. -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>app</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <!-- This module is BOTH a runnable demo AND a library other services depend on
                     (order-service wires its RateLimiter). A classifier keeps the plain library jar
                     as the MAIN artifact (so a dependent compiles against its classes) and attaches
                     the executable fat jar as 'app-exec.jar' for the local demo. Without this the
                     repackaged fat jar replaces the main artifact and cannot be used as a dependency. -->
                <configuration>
                    <classifier>exec</classifier>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
