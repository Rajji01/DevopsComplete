<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.shopflow</groupId>
    <artifactId>shopflow-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>ShopFlow</name>
    <description>Order + Inventory microservices</description>

    <modules>
        <module>shopflow-outbox</module>
        <module>inventory-service</module>
        <module>order-service</module>
        <module>notification-service</module>
        <module>payment-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <resilience4j.version>2.4.0</resilience4j.version>
        <springdoc.version>2.8.17</springdoc.version>
        <wiremock.version>3.13.2</wiremock.version>
        <aws-msk-iam-auth.version>2.3.9</aws-msk-iam-auth.version>
        <archunit.version>1.5.1</archunit.version>
        <!-- CVE patches (Walk 12): override Spring Boot's managed transitive versions to the fixed
             releases Trivy named, so `make build` + the CI image scan are clean. Drop these back to
             the BOM defaults once a Boot patch ships them. (spring-webmvc's fix is only in Spring 7 /
             Boot 4, so it can't be overridden here — it is triaged in /.trivyignore instead.) -->
        <jackson-bom.version>2.21.7</jackson-bom.version>   <!-- CVE-2026-89407/89425/68497/91776/91777 -->
        <netty.version>4.1.137.Final</netty.version>         <!-- CVE-2026-59901 (codec), CVE-2026-75595 (handler) -->
        <tomcat.version>10.1.59</tomcat.version>             <!-- CVE-2026-65182/65637/65905/68525 -->
        <postgresql.version>42.7.12</postgresql.version>     <!-- CVE-2026-54291 -->
        <!-- HttpComponents core5 IS Boot-managed, so a property override reaches it -->
        <httpcore5.version>5.4.3</httpcore5.version>         <!-- CVE-2026-54399 (httpcore5), 54428 (httpcore5-h2) -->
    </properties>

    <!-- lz4-java and snappy-java are pinned by kafka-clients and are NOT Spring Boot managed, so the
         property override above did not reach them (verified: they stayed at the vulnerable versions).
         Force the CVE-fixed versions explicitly here. Hits order/notification/payment (Kafka), not inventory. -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.lz4</groupId>
                <artifactId>lz4-java</artifactId>
                <version>1.11.4</version>                <!-- CVE-2026-106451 -->
            </dependency>
            <dependency>
                <groupId>org.xerial.snappy</groupId>
                <artifactId>snappy-java</artifactId>
                <version>1.1.10.9</version>              <!-- CVE-2026-108106/93451 -->
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Dependencies shared by every service -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- distributed tracing: traceId in logs + spans exported over OTLP (Tempo / Jaeger) -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- in-memory DB for tests; production uses PostgreSQL -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <executions>
                        <!-- exposes build version at /actuator/info -->
                        <execution>
                            <goals>
                                <goal>build-info</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
